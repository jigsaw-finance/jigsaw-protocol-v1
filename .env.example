# Provide chain name, used for deployment
# Strictly in upper case, e.g. "MAINNET", "SONIC", "SWELL"
CHAIN = ""

# Provide used chain's id
# MAINNET = 1
# SEPOLIA = 11155111
# ANVIL = 31337
# SONIC = 146
# SWELL = 1923
CHAIN_ID = ""

# Provide RPC URLs for each chain that will be used
# Name them strictly as shown below: {chain name in upper case}_RPC_URL
MAINNET_RPC_URL=""
ARBITRUM_RPC_URL=""
SEPOLIA_RPC_URL=""
ANVIL_RPC_URL=""

# Provide ETHERSCAN_API_KEY
ETHERSCAN_API_KEY=""

# Provide private key of the deployer for the contracts
# The deployer will be the initial owner for the deployed contracts
DEPLOYER_PRIVATE_KEY=""